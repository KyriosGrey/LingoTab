{
  "manifest_version": 3,
  "name": "LingoTab",
  "description": "Learn English in new tab",
  "version": "2.7.2",
  "chrome_url_overrides": {
    "newtab": "./dist/newTab/index.html"
  },
  "options_ui": {
    "page": "./dist/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "./assets/16.png",
    "32": "./assets/32.png",
    "48": "./assets/48.png",
    "128": "./assets/128.png"
  },
  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "img-src 'self' data: https://icons.duckduckgo.com https://www.google.com https://api.faviconkit.com; object-src 'self'; script-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "new-word-tab@graydesign",
      "strict_min_version": "109.0"
    }
  }
}

